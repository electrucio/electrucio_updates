TEXT -380 900 Left 2 ;Rgnd solo ata el neutro
TEXT -380 940 Left 2 ;a la masa del simulador.
TEXT 184 200 Left 2 ;TRAFO 1
TEXT 184 760 Left 2 ;TRAFO 2
TEXT 184 1320 Left 2 ;TRAFO 3
TEXT 950 1420 Left 2 ;V_S1..3 = el mando del rotativo.
TEXT 950 1460 Left 2 ;Solo uno cierra a la vez.
TEXT 1440 1060 Left 2 ;amortiguador del secundario
TEXT 2660 460 Left 2 ;R1 = carga minima (10,4 mA).  Cadj -> 80 dB de rechazo (fig. 21).
TEXT 3420 1240 Left 2 ;shunt en el RETORNO (fig. 32) -> SENSE al lazo
TEXT 1400 2260 Left 2 ;Vaux = trafo auxiliar de 1,5 VA + puente + 7812
TEXT 1400 2300 Left 2 ;0..0,44 V en ISET  ->  limite de 0 a 1,33 A
TEXT 2620 2440 Left 2 ;Integrador a 16 Hz. Mientras no limita, CCOUT=0 y Qcc esta cortado.
TEXT 3520 2260 Left 2 ;Vset 0..1 = pote de tension 0..3k9
TEXT 3520 2300 Left 2 ;Visetadj 0..1 = pote de corriente 0..4k7
TEXT 0 3200 Left 2 ;Rth_js 2,3 C/W (TO-220) + Rth_sa 2 C/W (disipador).
TEXT -400 3300 Left 2 ;=== DIRECTIVAS ===
TEXT -400 3360 Left 2 !.param TAP=2
TEXT -400 3392 Left 2 !.model SWMAN SW(Ron=10m Roff=1G Vt=6 Vh=2 level=2)
TEXT -400 3424 Left 2 !K1 Lp1 Ls1 0.999\nK2 Lp2 Ls2 0.999\nK3 Lp3 Ls3 0.999
TEXT -400 3520 Left 2 !.global Tj
TEXT -400 3552 Left 2 !.model 1N5408 D(Is=63.0n Rs=14.1m Bv=1000 Ibv=10u Cjo=53p M=0.333 N=1.30 Eg=1.11)
TEXT -400 3584 Left 2 !.model 1N4148 D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p M=0.4 tt=20n Iave=200m Vpk=75)
TEXT -400 3616 Left 2 !.model QNPN NPN(IS=1e-14 BF=200 VAF=100 RB=10 RC=1 CJE=11p CJC=4p TF=1n)
TEXT -400 3648 Left 2 !.lib LM317HV.sub\n.lib TL431ED.sub\n.lib LM358.sub
TEXT -400 3744 Left 2 !.ic V(Tj)=25 V(TSINK)=25
TEXT -400 3776 Left 2 !.options reltol=1e-3 abstol=1u vntol=1u
TEXT -400 3808 Left 2 !.tran 0 1.5 0 100u startup uic
TEXT 500 3360 Left 2 ;psu_cvcc - Fuente lineal DIY con LM317HV, CV y CC ajustables
TEXT 500 3392 Left 2 ;Circuitos de aplicacion de TI SNVS773D rev D.
TEXT 500 3424 Left 2 ;Protecciones de sobrecorriente, cortocircuito y
TEXT 500 3456 Left 2 ;sobretemperatura: las NATIVAS del chip.
TEXT 500 3520 Left 2 ;uic NO es opcional: sin el, el .op sale NaN.
TEXT 500 3552 Left 2 ;Los detalles estan en el README del directorio.
TEXT 500 3616 Left 2 ;OJO: el pote llega a 42 V en cualquier toma. Con TAP=1 o
TEXT 500 3648 Left 2 ;TAP=2, pasado el tope, el regulador entra en DROPOUT.
TEXT 1700 3300 Left 2 ;=== INSTRUMENTACION: los resultados salen en el .log (Ctrl+L) ===
TEXT 1700 3360 Left 2 !.param TM1=1.2 TM2=1.5\n.meas TRAN Vout_dc      AVG V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Vout_pp      PP  V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Vout_min     MIN V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Vout_pico    MAX V(VOUT)                FROM 0 TO {TM2}\n.meas TRAN Iout_dc      AVG I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Iout_pp      PP  I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Vraw_dc      AVG V(VRAW)                FROM {TM1} TO {TM2}\n.meas TRAN Vraw_pp      PP  V(VRAW)                FROM {TM1} TO {TM2}\n.meas TRAN Headroom     MIN V(VRAW)-V(VOUT)        FROM {TM1} TO {TM2}\n.meas TRAN Rechazo_dB   PARAM 20*log10(Vraw_pp/max(Vout_pp,1n))\n.meas TRAN Vadj_dc      AVG V(VADJ)                FROM {TM1} TO {TM2}\n.meas TRAN Vref_2v5     AVG V(VREF25)              FROM {TM1} TO {TM2}
TEXT 2560 3360 Left 2 !.meas TRAN V_iset       AVG V(ISET)                FROM {TM1} TO {TM2}\n.meas TRAN V_sense      AVG V(SENSE)               FROM {TM1} TO {TM2}\n.meas TRAN CCout        AVG V(CCOUT)               FROM {TM1} TO {TM2}\n.meas TRAN En_CC        PARAM if(CCout>0.5,1,0)\n.meas TRAN Ilim_A       PARAM V_iset/0.33\n.meas TRAN I_aux        AVG -I(Vaux)               FROM {TM1} TO {TM2}\n.meas TRAN Ipk_diodo    MAX I(D_B2)                FROM {TM1} TO {TM2}\n.meas TRAN Irms_sec     RMS I(Rs3)                 FROM {TM1} TO {TM2}\n.meas TRAN Tj_med       AVG V(Tj)                  FROM {TM1} TO {TM2}\n.meas TRAN Tj_max       MAX V(Tj)                  FROM 0 TO {TM2}\n.meas TRAN Tsink        AVG V(TSINK)               FROM {TM1} TO {TM2}\n.meas TRAN Margen_Tj    PARAM 125-Tj_max\n.meas TRAN P_LM317      AVG (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1))  FROM {TM1} TO {TM2}
TEXT 3420 3360 Left 2 !.meas TRAN P_LM317_pk   MAX (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1))  FROM {TM1} TO {TM2}\n.meas TRAN P_Rshunt     AVG V(VRTN)*I(Rshunt)      FROM {TM1} TO {TM2}\n.meas TRAN P_R1         AVG V(VOUT,VADJ)*I(R1)     FROM {TM1} TO {TM2}\n.meas TRAN P_R2         AVG V(VADJ)*I(R2)          FROM {TM1} TO {TM2}\n.meas TRAN P_Rbleed     AVG V(VRAW)*I(Rbleed)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rsnub      AVG V(NSNUB,ACLO)*I(Rsnub) FROM {TM1} TO {TM2}\n.meas TRAN P_Rfilt      AVG V(VRTN,SENSE)*I(Rfilt) FROM {TM1} TO {TM2}\n.meas TRAN P_Rref       AVG V(VCC,VREF25)*I(Rref)  FROM {TM1} TO {TM2}\n.meas TRAN P_Rset       AVG V(VREF25,ISET)*I(Rset) FROM {TM1} TO {TM2}\n.meas TRAN P_Rpot_i     AVG V(ISET)*I(Rpot_i)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rb         AVG V(CCOUT,CCB)*I(Rb)     FROM {TM1} TO {TM2}\n.meas TRAN P_Rbe        AVG V(CCB)*I(Rbe)          FROM {TM1} TO {TM2}\n.meas TRAN P_Qcc        AVG V(VADJ)*Ic(Qcc)        FROM {TM1} TO {TM2}
TEXT 1700 3840 Left 2 !.meas TRAN P_puente     AVG V(ACLO,VRAW)*I(D_B1)+V(ACHI,VRAW)*I(D_B2)-V(ACHI)*I(D_B3)-V(ACLO)*I(D_B4) FROM {TM1} TO {TM2}\n.meas TRAN P_sec        AVG V(NS1,TAP2)*I(Rs1)+V(NS2,TAP1)*I(Rs2)+V(NS3,ACLO)*I(Rs3) FROM {TM1} TO {TM2}\n.meas TRAN P_prim       AVG V(NP1,NEUTRAL)*I(Rp1)+V(NP2,NEUTRAL)*I(Rp2)+V(NP3,NEUTRAL)*I(Rp3) FROM {TM1} TO {TM2}
TEXT -376 548 Left 2 ;1. RED 230 Vca
TEXT 144 -108 Left 2 ;2. TRES TRANSFORMADORES ~13 Vrms - SECUNDARIOS EN SERIE
TEXT 924 12 Left 2 ;3. SELECTOR MANUAL 1P3T (break-before-make)
TEXT 1424 528 Left 2 ;4. PUENTE Y DEPOSITO
TEXT 2600 398 Left 2 ;5. LM317HV:  Vout = 1,25*(1 + R2/R1)
TEXT 2204 1192 Left 2 ;6. DIODOS DE PROTECCION - obligatorios con Vout > 25 V (fig. 15)
TEXT 3384 548 Left 2 ;7. SALIDA
TEXT 1384 1872 Left 2 ;8. REFERENCIA 2,5 V Y CONSIGNA DE CORRIENTE
TEXT 2564 1840 Left 2 ;9. LAZO DE CORRIENTE - el operacional tira de ADJ (fig. 31 + 32)
TEXT 3504 1888 Left 2 ;10. MANDOS
TEXT -56 2792 Left 2 ;MODELO TERMICO - no es circuito, es instrumentacion (1 V = 1 C)
