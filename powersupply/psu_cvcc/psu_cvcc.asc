TEXT -380 1000 Left 2 ;Rgnd solo ata el neutro
TEXT -380 1040 Left 2 ;a la masa del simulador.
TEXT 184 200 Left 2 ;TRAFO 1
TEXT 184 760 Left 2 ;TRAFO 2
TEXT 184 1320 Left 2 ;TRAFO 3
TEXT 950 1480 Left 2 ;SET sale del .param TAP: 1, 2 o 3.
TEXT 950 1520 Left 2 ;PSEL es el nodo de mando interno del modelo.
TEXT 1440 1060 Left 2 ;amortiguador del secundario
TEXT 2100 1060 Left 2 ;EN LA PLACA: dejar pads para un filtro CRC (Rcrc en serie en
TEXT 2100 1100 Left 2 ;el rail con puente de 0 ohm, Cbulk2 en paralelo a la entrada).
TEXT 2100 1140 Left 2 ;NO va montado: el rizado sin el ya esta dentro de spec comercial
TEXT 2100 1180 Left 2 ;y la mejora cabe dentro del error del modelo.  Se decide MIDIENDO
TEXT 2100 1220 Left 2 ;la unidad construida.  Valores medidos, en el README.
TEXT 2660 400 Left 2 ;R2c+R2f = dos potes de PANEL en serie (10k grueso + 1000 fino), 149 mW en total.
TEXT 2660 360 Left 2 ;R2 a VREF_-1v25 = VRTN - 1,25 (cero a 0 V).  Cadj a -5 V (S.Chip): 80 dB (fig. 21).
TEXT 2660 320 Left 2 ;R1+TP1 = 340 ohm fija la ESCALA, no la carga minima: de eso se encarga Q_min.
TEXT 2660 280 Left 2 ;TP1 ajusta el fondo de escala (potes de panel: +-20 %).  Subirla lo baja.
TEXT 2660 1320 Left 2 ;Los tres diodos son la fig. 15: obligatorios con Vout > 25 V.
TEXT 2660 1240 Left 2 ;Dos mandos independientes: VSET mueve el grueso y VSETF el fino.
TEXT 2660 1280 Left 2 ;Lo que ve el circuito es la SUMA de los dos.
TEXT 4176 2010 Left 2 ;Q_min = BD139 (TO-126): 8.8 mA, 0.40 W en el peor caso.
TEXT 4176 2050 Left 2 ;Re_min 1300 ohm / 3 W: acota el fallo en corto a 44 mA y 2.5 W.
TEXT 4176 2090 Left 2 ;Con el, la carga minima ya no depende de R1 ni del pote.
TEXT 3420 1240 Left 2 ;shunt en el RETORNO (fig. 32) -> SENSE al lazo
TEXT 1400 2540 Left 2 ;Vaux = trafo auxiliar de 1,5 VA + puente + 7812
TEXT 1400 2580 Left 2 ;0..0,44 V en ISET  ->  limite de 0 a 1,33 A
TEXT 2620 2520 Left 2 ;Integrador a 16 Hz. Mientras no limita, CCOUT=0 y Qcc esta cortado.
TEXT 2620 2560 Left 2 ;Qcc: BC546 (Vceo 65 V). Su colector ve VADJ, hasta 40 V.
TEXT 2620 2600 Left 2 ;Emisor y Rbe en VNEG (-5 V): con ellos en la referencia, Qcc se satura.
TEXT 1400 3040 Left 2 ;Vnraw = bruto del auxiliar (-17 V), ANTES del 79L05: el retorno de Q_min.
TEXT 1400 3080 Left 2 ;Vneg  = -5 V del auxiliar (79L05), V- del LM358 y base de Q_min.
TEXT 1400 3120 Left 2 ;U3 = LM337 a -1,25 V (como el P223): pata de referencia en VRTN.
TEXT 1400 3160 Left 2 ;Su corriente vuelve al COMUN, no por el shunt: tension Y corriente exactas.
TEXT 1400 3200 Left 2 ;Rnbleed 220 ohm (el valor del P223) le da su carga minima.
TEXT 1400 3240 Left 2 ;Qcc NO tira contra esta referencia sino contra los -5 V (como Silicon
TEXT 1400 3280 Left 2 ;Chip): contra -1,25 se satura y pierde el CC en un corto franco.
TEXT 4120 2840 Left 2 ;Vset 0..1 = pote GRUESO, 0..10000 ohm
TEXT 4120 2880 Left 2 ;Vsetf 0..1 = pote FINO, 0..1000 ohm  (3.7 V de recorrido)
TEXT 4120 2920 Left 2 ;Visetadj 0..1 = pote de corriente 0..4k7
TEXT 0 3200 Left 2 ;Rth_js 2,3 C/W (TO-220) + Rth_sa 2 C/W (disipador).
TEXT -400 3300 Left 2 ;=== DIRECTIVAS ===
TEXT -400 3360 Left 2 !.param TAP=2
TEXT -400 3392 Left 2 !.lib 1P3T_.sub\n.lib LM337.sub
TEXT -400 3424 Left 2 !K1 Lp1 Ls1 0.999\nK2 Lp2 Ls2 0.999\nK3 Lp3 Ls3 0.999
TEXT -400 3520 Left 2 !.global Tj
TEXT -400 3552 Left 2 !.model 1N5408 D(Is=63.0n Rs=14.1m Bv=1000 Ibv=10u Cjo=53p M=0.333 N=1.30 Eg=1.11)
TEXT -400 3584 Left 2 !.model 1N4148 D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p M=0.4 tt=20n Iave=200m Vpk=75)
TEXT -400 3616 Left 2 !.model QNPN NPN(IS=1e-14 BF=200 VAF=100 RB=10 RC=1 CJE=11p CJC=4p TF=1n)
TEXT -400 3648 Left 2 !.lib LM317HV.sub\n.lib TL431ED.sub\n.lib LM358.sub
TEXT -400 3744 Left 2 !.ic V(Tj)=25 V(TSINK)=25
TEXT -400 3776 Left 2 !.options reltol=1e-3 abstol=1u vntol=1u
TEXT -400 3808 Left 2 !.tran 0 1.5 0 100u startup uic
TEXT 500 3360 Left 2 ;psu_cvcc - Fuente lineal DIY con LM317HV, CV y CC ajustables
TEXT 500 3392 Left 2 ;Circuitos de aplicacion de TI SNVS773D rev D.
TEXT 500 3424 Left 2 ;Protecciones de sobrecorriente, cortocircuito y
TEXT 500 3456 Left 2 ;sobretemperatura: las NATIVAS del chip.
TEXT 500 3520 Left 2 ;uic NO es opcional: sin el, el .op sale NaN.
TEXT 500 3552 Left 2 ;Los detalles estan en el README del directorio.
TEXT 500 3616 Left 2 ;OJO 1: el pote llega a 40,6 V en cualquier toma. Con TAP=1 o
TEXT 500 3648 Left 2 ;TAP=2, pasado el tope, el regulador entra en DROPOUT.
TEXT 500 3712 Left 2 ;OJO 2: en TAP=3, en vacio y con la red a 253 V, el diferencial
TEXT 500 3744 Left 2 ;llega a 59,1 V contra los 60 V del MAXIMO ABSOLUTO (8.3.2).
TEXT 500 3776 Left 2 ;NO bajar del 20 % del pote estando en TAP=3.  Decision tomada
TEXT 500 3808 Left 2 ;a sabiendas: tres devanados de 13 V no caben con margen.
TEXT 1700 3300 Left 2 ;=== INSTRUMENTACION: los resultados salen en el .log (Ctrl+L) ===
TEXT 1700 3360 Left 2 !.param TM1=1.2 TM2=1.5\n.meas TRAN Vout_dc      AVG V(VOUT,VRTN)           FROM {TM1} TO {TM2}\n.meas TRAN Vout_pp      PP  V(VOUT,VRTN)           FROM {TM1} TO {TM2}\n.meas TRAN Vout_min     MIN V(VOUT,VRTN)           FROM {TM1} TO {TM2}\n.meas TRAN Vout_pico    MAX V(VOUT,VRTN)           FROM 0 TO {TM2}\n.meas TRAN Iout_dc      AVG I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Iload_dc     AVG I(Rload)               FROM {TM1} TO {TM2}\n.meas TRAN I_div        AVG I(R2c)                 FROM {TM1} TO {TM2}\n.meas TRAN Iout_pp      PP  I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Vraw_dc      AVG V(VRAW)                FROM {TM1} TO {TM2}\n.meas TRAN Vraw_pp      PP  V(VRAW)                FROM {TM1} TO {TM2}\n.meas TRAN Headroom     MIN V(VRAW)-V(VOUT)        FROM {TM1} TO {TM2}\n.meas TRAN Rechazo_dB   PARAM 20*log10(Vraw_pp/max(Vout_pp,1n))
TEXT 2560 3360 Left 2 !.meas TRAN Vadj_dc      AVG V(VADJ)                FROM {TM1} TO {TM2}\n.meas TRAN Vnref_dc     AVG V(VREF_-1v25)               FROM {TM1} TO {TM2}\n.meas TRAN Vref_2v5_dc  AVG V(VREF_2v5)              FROM {TM1} TO {TM2}\n.meas TRAN V_iset       AVG V(ISET)                FROM {TM1} TO {TM2}\n.meas TRAN V_sense      AVG V(SENSE)               FROM {TM1} TO {TM2}\n.meas TRAN CCout        AVG V(CCOUT)               FROM {TM1} TO {TM2}\n.meas TRAN Ic_Qcc       AVG Ic(Qcc)                FROM {TM1} TO {TM2}\n.meas TRAN En_CC        PARAM if(Ic_Qcc>1m,1,0)\n.meas TRAN Ilim_A       PARAM V_iset/0.33\n.meas TRAN I_aux        AVG -I(Vaux)               FROM {TM1} TO {TM2}\n.meas TRAN Ipk_diodo    MAX I(D_B2)                FROM {TM1} TO {TM2}\n.meas TRAN Irms_sec     RMS I(Rs3)                 FROM {TM1} TO {TM2}\n.meas TRAN Tj_med       AVG V(Tj)                  FROM {TM1} TO {TM2}
TEXT 3420 3360 Left 2 !.meas TRAN Tj_max       MAX V(Tj)                  FROM 0 TO {TM2}\n.meas TRAN Tsink        AVG V(TSINK)               FROM {TM1} TO {TM2}\n.meas TRAN Margen_Tj    PARAM 125-Tj_max\n.meas TRAN P_LM317      AVG (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1)+Ic(Q_min)) FROM {TM1} TO {TM2}\n.meas TRAN P_LM317_pk   MAX (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1)+Ic(Q_min)) FROM {TM1} TO {TM2}\n.meas TRAN P_Rshunt     AVG V(VRTN)*I(Rshunt)      FROM {TM1} TO {TM2}\n.meas TRAN P_R1         AVG V(VOUT,VR1T)*I(R1)     FROM {TM1} TO {TM2}\n.meas TRAN P_TP1        AVG V(VR1T,VADJ)*I(RTP1)   FROM {TM1} TO {TM2}\n.meas TRAN P_R2c        AVG V(VADJ,VMIDP)*I(R2c)   FROM {TM1} TO {TM2}\n.meas TRAN P_R2f        AVG V(VMIDP,VREF_-1v25)*I(R2f)  FROM {TM1} TO {TM2}\n.meas TRAN I_min        AVG Ic(Q_min)              FROM {TM1} TO {TM2}\n.meas TRAN I_minload    PARAM I_div+I_min\n.meas TRAN P_Q_min      AVG V(VOUT,EMIN)*Ic(Q_min) FROM {TM1} TO {TM2}
TEXT 4280 3360 Left 2 !.meas TRAN P_Re_min     AVG V(EMIN,VNRAW)*I(Re_min) FROM {TM1} TO {TM2}\n.meas TRAN Vce_Q_min    MAX V(VOUT,EMIN)           FROM 0 TO {TM2}\n.meas TRAN P_Rbleed     AVG V(VRAW)*I(Rbleed)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rsnub      AVG V(NSNUB,ACLO)*I(Rsnub) FROM {TM1} TO {TM2}\n.meas TRAN P_Rfilt      AVG V(VRTN,SENSE)*I(Rfilt) FROM {TM1} TO {TM2}\n.meas TRAN P_Rref       AVG V(VCC,VREF_2v5)*I(Rref)  FROM {TM1} TO {TM2}\n.meas TRAN P_Rset       AVG V(VREF_2v5,ISET)*I(Rset) FROM {TM1} TO {TM2}\n.meas TRAN P_Rpot_i     AVG V(ISET)*I(Rpot_i)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rb         AVG V(CCOUT,CCB)*I(Rb)     FROM {TM1} TO {TM2}\n.meas TRAN P_Rbe        AVG V(CCB,VNEG)*I(Rbe)     FROM {TM1} TO {TM2}\n.meas TRAN P_Qcc        AVG V(VADJ,VNEG)*Ic(Qcc)   FROM {TM1} TO {TM2}\n.meas TRAN P_Rint       AVG V(CCIN,ISET)*I(Rint)   FROM {TM1} TO {TM2}\n.meas TRAN P_Rnbleed    AVG V(VREF_-1v25)*I(Rnbleed)    FROM {TM1} TO {TM2}
