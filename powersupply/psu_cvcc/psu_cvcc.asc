TEXT 0 -64 Left 2 ;=== Red y transformadores: tres secundarios de ~13 Vrms en serie ===
TEXT 0 384 Left 2 ;=== Selector manual de tomas (rotativo 1P3T break-before-make) ===
TEXT 0 608 Left 2 ;=== Rectificacion ===
TEXT 1408 640 Left 2 ;Vaux = trafo auxiliar de 1,5 VA + puente + 7812
TEXT 0 832 Left 2 ;=== Referencia de 2,5 V y regulador (datasheet fig. 16 y 21) ===
TEXT 0 1056 Left 2 ;=== Diodos de proteccion: obligatorios con Vout>25 V (fig. 15) ===
TEXT 704 1056 Left 2 ;=== Sensado de corriente (shunt en el retorno, fig. 32) ===
TEXT 0 1280 Left 2 ;=== Lazo de corriente: el operacional ataca la base del NPN que tira de ADJ (fig. 31 + fig. 32) ===
TEXT 0 1504 Left 2 ;=== Modelo termico (solo simulacion): union -> disipador -> ambiente ===
TEXT 0 1728 Left 2 ;=== Estimulos de simulacion (los dos potes y la carga) ===
TEXT 0 1952 Left 2 ;Vset 0..1 = pote de tension de 0..3k9 ; Visetadj 0..1 = pote de corriente de 0..4k7. OJO: Vset>0.75 en TAP=2 mete al regulador en DROPOUT y el rizado sube x800.
TEXT 0 2016 Left 2 !.param TAP=2
TEXT 0 2048 Left 2 !.model SWMAN SW(Ron=10m Roff=1G Vt=6 Vh=2 level=2)
TEXT 0 2080 Left 2 !K1 Lp1 Ls1 0.999\nK2 Lp2 Ls2 0.999\nK3 Lp3 Ls3 0.999
TEXT 0 2176 Left 2 !.global Tj
TEXT 0 2208 Left 2 !.model 1N5408 D(Is=63.0n Rs=14.1m Bv=1000 Ibv=10u Cjo=53p M=0.333 N=1.30 Eg=1.11)
TEXT 0 2240 Left 2 !.model 1N4148 D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p M=0.4 tt=20n Iave=200m Vpk=75)
TEXT 0 2272 Left 2 !.model QNPN NPN(IS=1e-14 BF=200 VAF=100 RB=10 RC=1 CJE=11p CJC=4p TF=1n)
TEXT 0 2304 Left 2 !.lib LM317HV.sub\n.lib TL431ED.sub\n.lib LM358.sub
TEXT 0 2400 Left 2 !.ic V(Tj)=25 V(TSINK)=25
TEXT 0 2432 Left 2 !.options reltol=1e-3 abstol=1u vntol=1u
TEXT 0 2464 Left 2 !.tran 0 1.5 0 100u startup uic
TEXT 900 2016 Left 2 ;psu_cvcc - Fuente lineal DIY con LM317HV, CV y CC ajustables
TEXT 900 2048 Left 2 ;Circuitos de aplicacion de TI SNVS773D rev D.
TEXT 900 2080 Left 2 ;Protecciones de sobrecorriente, cortocircuito y
TEXT 900 2112 Left 2 ;sobretemperatura: las NATIVAS del chip.
TEXT 900 2176 Left 2 ;uic NO es opcional: sin el, el .op sale NaN.
TEXT 900 2208 Left 2 ;Los detalles estan en el README del directorio.
TEXT 1800 1952 Left 2 ;=== Instrumentacion: los resultados salen en el .log (Ctrl+L) ===
TEXT 1800 2016 Left 2 !.param TM1=1.2 TM2=1.5\n.meas TRAN Vout_dc      AVG V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Vout_pp      PP  V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Vout_min     MIN V(VOUT)                FROM {TM1} TO {TM2}\n.meas TRAN Iout_dc      AVG I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Iout_pp      PP  I(Rshunt)              FROM {TM1} TO {TM2}\n.meas TRAN Vraw_dc      AVG V(VRAW)                FROM {TM1} TO {TM2}\n.meas TRAN Vraw_pp      PP  V(VRAW)                FROM {TM1} TO {TM2}
TEXT 2420 2016 Left 2 !.meas TRAN Headroom     MIN V(VRAW)-V(VOUT)        FROM {TM1} TO {TM2}\n.meas TRAN Rechazo_dB   PARAM 20*log10(Vraw_pp/max(Vout_pp,1n))\n.meas TRAN Vadj_dc      AVG V(VADJ)                FROM {TM1} TO {TM2}\n.meas TRAN Vref_2v5     AVG V(VREF25)              FROM {TM1} TO {TM2}\n.meas TRAN V_iset       AVG V(ISET)                FROM {TM1} TO {TM2}\n.meas TRAN V_sense      AVG V(SENSE)               FROM {TM1} TO {TM2}\n.meas TRAN CCout        AVG V(CCOUT)               FROM {TM1} TO {TM2}\n.meas TRAN En_CC        PARAM if(CCout>0.5,1,0)
TEXT 3040 2016 Left 2 !.meas TRAN Ilim_A       PARAM V_iset/0.33\n.meas TRAN P_LM317      AVG (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1))  FROM {TM1} TO {TM2}\n.meas TRAN P_LM317_pk   MAX (V(VRAW)-V(VOUT))*(I(Rshunt)+I(R1))  FROM {TM1} TO {TM2}\n.meas TRAN P_Rshunt     AVG V(VRTN)*I(Rshunt)      FROM {TM1} TO {TM2}\n.meas TRAN P_R1         AVG V(VOUT,VADJ)*I(R1)     FROM {TM1} TO {TM2}\n.meas TRAN P_R2         AVG V(VADJ)*I(R2)          FROM {TM1} TO {TM2}\n.meas TRAN P_Rbleed     AVG V(VRAW)*I(Rbleed)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rsnub      AVG V(NSNUB,ACLO)*I(Rsnub) FROM {TM1} TO {TM2}
TEXT 1800 2316 Left 2 !.meas TRAN P_Rfilt      AVG V(VRTN,SENSE)*I(Rfilt) FROM {TM1} TO {TM2}\n.meas TRAN P_Rref       AVG V(VCC,VREF25)*I(Rref)  FROM {TM1} TO {TM2}\n.meas TRAN P_Rset       AVG V(VREF25,ISET)*I(Rset) FROM {TM1} TO {TM2}\n.meas TRAN P_Rpot_i     AVG V(ISET)*I(Rpot_i)      FROM {TM1} TO {TM2}\n.meas TRAN P_Rb         AVG V(CCOUT,CCB)*I(Rb)     FROM {TM1} TO {TM2}\n.meas TRAN P_Rbe        AVG V(CCB)*I(Rbe)          FROM {TM1} TO {TM2}\n.meas TRAN P_Qcc        AVG V(VADJ)*Ic(Qcc)        FROM {TM1} TO {TM2}\n.meas TRAN P_puente     AVG V(ACLO,VRAW)*I(D_B1)+V(ACHI,VRAW)*I(D_B2)-V(ACHI)*I(D_B3)-V(ACLO)*I(D_B4) FROM {TM1} TO {TM2}
TEXT 2420 2316 Left 2 !.meas TRAN Ipk_diodo    MAX I(D_B2)                FROM {TM1} TO {TM2}\n.meas TRAN Irms_sec     RMS I(Rs3)                 FROM {TM1} TO {TM2}\n.meas TRAN P_sec        AVG V(NS1,TAP2)*I(Rs1)+V(NS2,TAP1)*I(Rs2)+V(NS3,ACLO)*I(Rs3) FROM {TM1} TO {TM2}\n.meas TRAN P_prim       AVG V(NP1,NEUTRAL)*I(Rp1)+V(NP2,NEUTRAL)*I(Rp2)+V(NP3,NEUTRAL)*I(Rp3) FROM {TM1} TO {TM2}\n.meas TRAN Tj_med       AVG V(Tj)                  FROM {TM1} TO {TM2}\n.meas TRAN Tj_max       MAX V(Tj)                  FROM 0 TO {TM2}\n.meas TRAN Tsink        AVG V(TSINK)               FROM {TM1} TO {TM2}\n.meas TRAN Margen_Tj    PARAM 125-Tj_max
TEXT 3040 2316 Left 2 !.meas TRAN I_aux        AVG -I(Vaux)               FROM {TM1} TO {TM2}\n.meas TRAN Vout_pico    MAX V(VOUT)                FROM 0 TO {TM2}
