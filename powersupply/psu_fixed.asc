TEXT 16 23296 Left 2 !.model IRF9540N VDMOS(pchan Vds=-100 Ron=0.117 Qg=51n Vto=-3.0 Kp=6 lambda=0.005 Rs=20m Rd=60m Rg=2 Cgdmax=1.4n Cgdmin=0.06n Cgs=1.1n Cjo=0.5n Is=20p mfg=IR)
TEXT 16 23392 Left 2 !.model IRF4905 VDMOS(pchan Vds=-55 Ron=0.02 Qg=180n Vto=-3.8 Kp=25 Rs=5m Rd=10m Rg=3 Cgdmax=2n Cgdmin=0.5n Cgs=3.4n Cjo=1n Is=10p mfg=IR)
