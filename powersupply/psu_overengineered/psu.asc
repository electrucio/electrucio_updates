TEXT 960 3064 Left 2 !Vamb  amb 0 25\nRth   Tj amb 1.5\nCth   Tj amb 4\nBheat amb Tj I=limit((V(VRAW+)-V(VLOAD))*abs(I(R22)),0,2k)
TEXT 1808 2936 Left 2 !.subckt LM35 VS OUT GND\nBo OUT GND V=0.01*V(Tj)     ; 10 mV/°C leídos del nodo térmico Tj\nRi OUT GND 100k\n.ends LM35
TEXT 952 2920 Left 2 !Bfan Tj amb I=((V(VCC)-V(FAN_HI))/12)*0.93*(V(Tj)-V(amb))
